# Required - Groq API 키 (https://console.groq.com에서 발급)
GROQ_API_KEY=your_groq_api_key_here

# Optional - 모델 설정
EMBEDDING_MODEL=BAAI/bge-m3
LLM_MODEL=llama-3.3-70b-versatile

# Optional - 청킹 설정
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Optional - RAG 설정
RETRIEVAL_K=4
MAX_HISTORY=10

# Optional - 파일 제약사항
MAX_FILE_SIZE_MB=50
MAX_PAGES=500
